# --- Sitio ---------------------------------------------------------------
# Dominio público definitivo (se usa en sitemap, canonical y Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.tudominio.co

# --- Contacto (si una variable está vacía, el dato no se muestra) --------
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
# Formato internacional sin "+", p. ej. 573001234567 (activa el botón flotante de WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_CITY=Colombia

# --- Información legal empresarial (footer y políticas) -------------------
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_NIT=
NEXT_PUBLIC_LEGAL_ADDRESS=

# --- Redes sociales -------------------------------------------------------
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# --- Backend --------------------------------------------------------------
# URL del API FastAPI (sólo servidor). Vacía = el carrito informa que el envío
# en línea aún no está habilitado y ofrece WhatsApp/correo. No se simulan envíos.
NEXODOC_API_URL=
# Secreto compartido con el backend (PROXY_SECRET) para enviarle la IP real del
# cliente. Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
NEXODOC_PROXY_SECRET=
# Opcional: URL pública de la misma API para subir soportes directo desde el
# navegador (necesario en Vercel para archivos de más de ~4 MB).
NEXT_PUBLIC_API_URL=
