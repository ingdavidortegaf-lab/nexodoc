# Entorno: development | test | production
# Cualquier valor distinto de development/test se trata como producción.
ENVIRONMENT=development

# PostgreSQL (asyncpg)
DATABASE_URL=postgresql+asyncpg://nexodoc:cambia-esto@localhost:5432/nexodoc

# Seguridad: genera valores con  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
BLIND_INDEX_KEY=
# Mismo valor que NEXODOC_PROXY_SECRET en el frontend
PROXY_SECRET=
# Clave Fernet para cifrar campos sensibles:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Sólo si la API está detrás de Cloudflare y no es accesible directamente
TRUST_CLOUDFLARE=false

# Orígenes permitidos (el frontend) y URL pública del sitio (regreso del pago)
CORS_ORIGINS=http://localhost:3000
PUBLIC_SITE_URL=http://localhost:3000

# Almacenamiento privado S3/R2
S3_ENDPOINT_URL=
S3_BUCKET=nexodoc-documentos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=20

# Retención de documentos de clientes tras cerrar la solicitud (días)
DOCUMENT_RETENTION_DAYS=180

# El valor de verificación se descuenta del total de la cotización
CREDIT_VERIFICATION_FEE=true

# --- Wompi: PSE, tarjetas, Nequi y botón Bancolombia --------------------------
# Panel de Wompi → Desarrolladores. Llaves pub_test_… = sandbox; pub_prod_… = producción.
# URL de eventos a configurar en Wompi: https://api.tudominio.co/v1/payments/wompi/events
WOMPI_ENABLED=false
WOMPI_PUBLIC_KEY=
WOMPI_INTEGRITY_SECRET=
WOMPI_EVENTS_SECRET=

# --- Avisos al cliente (pedido recibido, pago aprobado, cotización, cambios de estado)
# Correo con Resend (https://resend.com): verifica tu dominio y crea una API key.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=NEXODOC <pedidos@tudominio.co>
# WhatsApp Business Cloud API: plantilla aprobada con 4 variables (nombre, pedido, documento, estado)
WHATSAPP_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE_STATUS=nexodoc_estado_pedido

# Otras integraciones (apagadas hasta configurarse)
MERCADOPAGO_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
